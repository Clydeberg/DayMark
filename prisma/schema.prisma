generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemType {
  TASK
  EVENT
  MEETING
  DEADLINE
}

enum ItemStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum PermissionLevel {
  VIEW
  EDIT
}

model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  passwordHash String
  ownedItems   CalendarItem[]   @relation("ItemOwner")
  assignedItems CalendarItem[]  @relation("ItemAssignee")
  permissions  ItemPermission[]
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
}

model CalendarItem {
  id          String           @id @default(cuid())
  title       String
  description String?
  type        ItemType         @default(TASK)
  status      ItemStatus       @default(TODO)
  priority    Priority         @default(MEDIUM)
  startAt     DateTime         @db.Timestamptz(3)
  endAt       DateTime?        @db.Timestamptz(3)
  allDay      Boolean          @default(false)
  ownerId     String
  owner       User             @relation("ItemOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?            @relation("ItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  permissions ItemPermission[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@index([startAt])
  @@index([endAt])
  @@index([ownerId])
  @@index([assigneeId])
}

model ItemPermission {
  id      String          @id @default(cuid())
  level   PermissionLevel @default(VIEW)
  itemId  String
  item    CalendarItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId  String
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId])
}
